datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  quizzes      Quiz[]
  rooms        Room[]
  scores       Score[]
}

model Quiz {
  id          String     @id @default(uuid())
  title       String
  description String?
  category    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  hostId      String
  host        User       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  questions   Question[]
  rooms       Room[]
  scores      Score[]
}

model Question {
  id              String   @id @default(uuid())
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text            String
  timer           Int      @default(20) // in seconds
  points          Int      @default(100)
  options         Option[]
  correctOptionId String? // Stores correct Option ID
  answers         Answer[]
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  answers    Answer[]
}

model Room {
  id                   String   @id @default(uuid())
  code                 String   @unique // 6-character room code
  quizId               String
  quiz                 Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  hostId               String
  host                 User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  status               String   @default("LOBBY") // LOBBY, PLAYING, ENDED
  currentQuestionIndex Int      @default(-1)
  currentQuestionState String   @default("IDLE") // IDLE, ANSWERING, REVEALED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  players              Player[]
}

model Player {
  id                  String     @id @default(uuid())
  roomId              String
  room                Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId              String? // if authenticated player
  name                String
  socketId            String?
  score               Int        @default(0)
  correctAnswersCount Int        @default(0)
  totalResponseTime   Float      @default(0) // total response time in seconds
  isDisconnected      Boolean    @default(false)
  warningCount        Int        @default(0)
  answers             Answer[]
  cheatLogs           CheatLog[]
}

model Answer {
  id             String   @id @default(uuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId       String
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  responseTimeMs Float // speed bonus depends on this
  pointsEarned   Int      @default(0)
  createdAt      DateTime @default(now())
}

model Score {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username        String
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score           Int
  rank            Int
  correctAnswers  Int
  avgResponseTime Float
  createdAt       DateTime @default(now())
}

model CheatLog {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type      String // e.g., "TAB_SWITCH"
  timestamp DateTime @default(now())
  details   String?
}
